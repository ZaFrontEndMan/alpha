# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Paymob credentials are read only by Vercel serverless functions. Do not prefix
# these names with VITE_, otherwise Vite would expose them to the browser.
PAYMOB_API_KEY="YOUR_PAYMOB_API_KEY"
PAYMOB_CARD_INTEGRATION_ID="YOUR_CARD_INTEGRATION_ID"
PAYMOB_CASH_INTEGRATION_ID="YOUR_CASH_INTEGRATION_ID"
PAYMOB_IFRAME_ID="YOUR_IFRAME_ID"
PAYMOB_HMAC_SECRET="YOUR_PAYMOB_HMAC_SECRET"
PAYMOB_AUTH_URL="https://accept.paymob.com/api/auth/tokens"
PAYMOB_ORDER_URL="https://accept.paymob.com/api/ecommerce/orders"
PAYMOB_IFRAME_URL="https://accept.paymob.com/api/acceptance/iframes/YOUR_IFRAME_ID?payment_token="

# SMTP Email Configuration (Site4Now / drahmedassem.com)
SMTP_HOST="mail5017.site4now.net"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@drahmedassem.com"
SMTP_PASS="YOUR_MAILBOX_PASSWORD"
EMAIL_FROM="\"Dr. Ahmed Assem\" <info@drahmedassem.com>"
OWNER_EMAIL="postmaster@drahmedassem.com"

# Cloudinary: read only by api/transformations.ts. Never prefix the key/secret with VITE_.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
CLOUDINARY_TRANSFORMATIONS_FOLDER="assem"
